# Red de seguridad si el gestor se cae: borra los recursos caducados con etiqueta triage.env y nada más.
# Nunca llama al modelo.
[Unit]
Description=Triage: barrido de entornos caducados
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=triage-gestor
Group=triage-gestor
SupplementaryGroups=docker
Environment=HOME=/var/lib/triage-gestor
StateDirectory=triage-gestor
StateDirectoryMode=0700
ExecStart=/usr/bin/java -Xmx64m -XX:+UseSerialGC -XX:-UsePerfData -cp /opt/triage/gestor/triage-gestor.jar:/opt/triage/gestor/triage-comun.jar dev.deveps.triage.gestor.Main --barrer
TimeoutStartSec=120
MemoryMax=192M

IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
