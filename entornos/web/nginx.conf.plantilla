server {
    listen 80;
    listen 443 ssl;
    server_name web tienda.interna;

    ssl_certificate     /run/tls/actual.crt;
    ssl_certificate_key /run/tls/actual.key;

    location = /nginx-salud {
        access_log off;
        allow 127.0.0.1;
        deny all;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;
    }
}
